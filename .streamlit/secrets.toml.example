[app]
user_name = "Your Name"

[enable_banking]
app_id = "your-app-uuid"      # from https://enablebanking.com → your application

# Model connection — choose a provider in Settings and paste its key.
# Save writes the key into the matching section below so it survives a restart.
# Leaving the app open does not call the model.
[anthropic]
api_key = "sk-ant-..."        # from https://console.anthropic.com — direct Claude

[openai]
api_key = "sk-..."            # from https://platform.openai.com/api-keys — direct OpenAI

[openrouter]
api_key = "sk-or-v1-..."      # from https://openrouter.ai/keys — one key, many models

[trade_republic]               # optional — remove section if not using TR
phone_no = "+4917612345678"   # your full phone number including country code
pin = "1234"                  # your 4-digit Trade Republic PIN

[email]                        # optional — remove section if not using email summaries
to = "you@example.com"
user = "you@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"  # Gmail App Password (not your regular password)
                                       # Generate at myaccount.google.com → Security → App passwords
